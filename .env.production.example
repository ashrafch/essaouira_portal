# Production environment template.
# Copy to .env.production and fill every REQUIRED value. Never commit .env.production.
#
#   docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# --- Required secrets (compose refuses to start without them) ---
POSTGRES_PASSWORD=
AUTH_SECRET_KEY=
ADMIN_PASSWORD=

# --- Identity ---
ADMIN_USERNAME=owner
POSTGRES_DB=essa
POSTGRES_USER=essa

# --- Ports ---
# Public HTTP port of the portal (put a TLS reverse proxy in front for internet exposure).
WEB_PORT=80

# --- CORS ---
# Only needed if the API is consumed from origins other than the web proxy.
# CORS_ORIGINS=https://portal.example.com

# --- Smart provider ---
SMART_PROVIDER_MODE=mock
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
HOME_ASSISTANT_INCLUDE_DOMAINS=binary_sensor,sensor,switch,climate,input_boolean,input_number
HOME_ASSISTANT_UNIT_HINTS={}

# --- Ops profile (docker compose --profile ops) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
