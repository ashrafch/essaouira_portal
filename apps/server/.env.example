DATABASE_URL=postgresql+psycopg2://essa:essa@localhost:5432/essa
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

AUTH_ENABLED=true
AUTH_SECRET_KEY=change-me-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=720
ADMIN_USERNAME=owner
ADMIN_PASSWORD=owner123
ADMIN_PASSWORD_HASH=
ADMIN_ROLE=owner
ADMIN_TENANT_ID=default
PASSWORD_MIN_LENGTH=8

AUTO_CREATE_SCHEMA=true
AUTO_SEED_DATA=true
SMART_PROVIDER_MODE=mock
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=8
HOME_ASSISTANT_INCLUDE_DOMAINS=switch,light,climate,lock,sensor,binary_sensor
HOME_ASSISTANT_UNIT_HINTS={}
