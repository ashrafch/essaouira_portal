# Local development environment for Docker Compose.
# Copy to .env and adjust. Every value has a safe dev default in docker-compose.yml;
# for production use .env.production (see .env.production.example).

# --- Ports ---
WEB_PORT=8081
API_PORT=8000
DB_PORT=5432

# --- Environment ---
# development | production (production enables fail-fast checks on weak secrets)
APP_ENV=development

# --- Credentials (dev defaults are fine locally, never for real deployments) ---
POSTGRES_DB=essa
POSTGRES_USER=essa
POSTGRES_PASSWORD=essa
AUTH_SECRET_KEY=change-me-strong-secret
ADMIN_USERNAME=owner
ADMIN_PASSWORD=owner123

# --- Schema management ---
# Dev default: schema auto-created and demo data seeded at startup.
RUN_MIGRATIONS=false
AUTO_CREATE_SCHEMA=true
AUTO_SEED_DATA=true

# --- Smart provider mode: mock | home_assistant | villacore ---
# mock          = simulated devices, no external dependency (safe default)
# home_assistant = generic HA instance
# villacore      = HA running the VillaCore project (adds capabilities, unit
#                  workflows, facilities and the event contract). See
#                  docs/VILLACORE_LINK.md
SMART_PROVIDER_MODE=mock

# With the villacore overlay the backend reaches HA by service name over the
# shared `villacore_link` network (no published port, works in prod too):
#   docker compose -f docker-compose.yml -f docker-compose.villacore.yml up -d
HOME_ASSISTANT_URL=http://home-assistant:8123
# Long-lived access token created in HA: profile -> Security -> Long-lived tokens
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
# Empty = let the provider decide (villacore uses its own profile allowlist).
HOME_ASSISTANT_INCLUDE_DOMAINS=
HOME_ASSISTANT_UNIT_HINTS={}

# --- VillaCore Link ---
# Shared secret VillaCore sends as X-Smart-Ingest-Token on the event webhook.
# Empty = inbound push disabled (portal only pulls). Generate a random value.
SMART_INGEST_TOKEN=
# Reconciliation loop period in seconds. 0 = off (poll manually or via cron).
SMART_POLL_INTERVAL_SECONDS=0
# Site id used by the VillaCore simulator/topics (VILLACORE_SITE_ID there).
VILLACORE_SITE_ID=dev

ESSENTIAL_DEVICE_CATEGORIES=door_sensor,leak_sensor,climate_controller,smart_light

# --- Ops profile ---
# VillaCore's Grafana already owns 3000 on this host, so ours defaults to 3001.
GRAFANA_PORT=3001
