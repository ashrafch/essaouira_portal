# Local development environment for Docker Compose.
# Copy to .env and adjust. Every value has a safe dev default in docker-compose.yml;
# for production use .env.production (see .env.production.example).

# --- Ports ---
WEB_PORT=8081
API_PORT=8000
DB_PORT=5432

# --- Environment ---
# development | production (production enables fail-fast checks on weak secrets)
APP_ENV=development

# --- Credentials (dev defaults are fine locally, never for real deployments) ---
POSTGRES_DB=essa
POSTGRES_USER=essa
POSTGRES_PASSWORD=essa
AUTH_SECRET_KEY=change-me-strong-secret
ADMIN_USERNAME=owner
ADMIN_PASSWORD=owner123

# --- Schema management ---
# Dev default: schema auto-created and demo data seeded at startup.
RUN_MIGRATIONS=false
AUTO_CREATE_SCHEMA=true
AUTO_SEED_DATA=true

# --- Smart provider mode: mock | home_assistant ---
SMART_PROVIDER_MODE=mock

# Home Assistant (for Dockerized backend, use host.docker.internal)
HOME_ASSISTANT_URL=http://host.docker.internal:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_TIMEOUT_SECONDS=10
HOME_ASSISTANT_INCLUDE_DOMAINS=binary_sensor,sensor,switch,climate,input_boolean,input_number
HOME_ASSISTANT_UNIT_HINTS={}

ESSENTIAL_DEVICE_CATEGORIES=door_sensor,leak_sensor,climate_controller,smart_light
